# AI provider. Tried in this order; if one fails the next one is used.
# 1. DeepSeek web chat (free, unofficial): your personal userToken from chat.deepseek.com (DevTools > Application > Local Storage > userToken)
DEEPSEEK_TOKEN=
# 2. NVIDIA NIM (free tier with an nvapi key)
NVIDIA_API_KEY=your_key_here
# TEACHAI_MODEL=nvidia/nemotron-3-super-120b-a12b
# Force one provider: deepseek | nvidia (default: auto)
# AI_PROVIDER=auto

# Invite-only access (on by default). Set ACCESS_REQUIRED=0 to open the app to everyone, e.g. on your own machine.
# ACCESS_REQUIRED=1
# Codes live in data/coupons.json: `npm run coupon -- create --for "Teacher X1"` (one teacher, one device, one use).
# Or let your own service decide: the server POSTs {"code":"ABCD1234"} to this URL with "Authorization: Bearer <key>"
# and expects {"ok":true,"id":"teacher-7","expires":"2026-12-31T00:00:00Z"} (id and expires optional) or {"ok":false}.
# ACCESS_API_URL=https://your-project.vercel.app/api/redeem
# ACCESS_API_KEY=
# Signs the access cookie. Set a long random value in production so sessions survive a restart on any host.
# ACCESS_SECRET=
# Set to 1 when the app runs behind a proxy so rate limits use the real visitor address (x-forwarded-for).
# TRUST_PROXY=0
# Public address of the site, for link previews and the sitemap (also enables the Secure cookie flag on https).
# SITE_URL=https://teach.ai

# Free hosted Postgres (Neon/Supabase). When set, exams, waiting list and messages are stored there instead of data/.
DATABASE_URL=

# Password for the admin page at /admin. The admin is switched off when this is empty. Use a long passphrase.
ADMIN_PASSWORD=
# Optional: only these addresses may open the admin (comma separated).
# ADMIN_IPS=203.0.113.7
